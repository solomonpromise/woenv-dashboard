# Copy to .env and adjust. docker-compose reads this file automatically.

# --- Database -----------------------------------------------------------
POSTGRES_USER=woenv_user
POSTGRES_PASSWORD=woenv_pass
POSTGRES_DB=woenv_db

# Host port for PostgreSQL. 5433 avoids colliding with a local install.
DB_PORT=5433
API_PORT=8000
WEB_PORT=3000

# --- Backend ------------------------------------------------------------
# Used when running the API outside Docker. Inside Docker, compose builds this
# from the POSTGRES_* values above and points at the `db` service.
DATABASE_URL=postgresql://woenv_user:woenv_pass@127.0.0.1:5433/woenv_db

# REQUIRED. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=480
UPLOAD_DIR=./uploads

# Optional. When set, the container entrypoint creates this admin user on
# startup and does nothing on later boots. Leave empty to create the admin by
# hand with `python -m scripts.seed_admin`.
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@woenv.local

# JSON array - pydantic-settings parses List[str] as JSON, so a bare
# comma-separated string will fail to load.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Frontend -----------------------------------------------------------
# Leave empty to use the dev-server proxy (or the nginx proxy in Docker).
# If set, give the API origin only - the /api/v1 prefix is added by the client.
VITE_API_URL=
